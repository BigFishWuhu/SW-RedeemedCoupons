# 所有配置均为可选。默认启动后，在网页中创建管理员账号和密码。

# Web 端口与定时兑换码检查
PORT=3000
APP_TIMEZONE=Asia/Shanghai
COUPON_CHECK_ENABLED=true
COUPON_CHECK_HOURS=1

# 可选：无人值守部署时，通过环境变量预先创建管理员
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password

# 使用 GitHub 镜像时取消注释，并替换为自己的仓库名
# IMAGE_NAME=ghcr.io/owner/sw-redeemed-coupons:latest
