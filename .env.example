# 所有配置均为可选。默认启动后，在网页中创建管理员账号和密码。

# Web 端口与自动兑换时间
PORT=3000
APP_TIMEZONE=Asia/Shanghai
AUTO_REDEEM=true
AUTO_REDEEM_HOUR=12
AUTO_REDEEM_MINUTE=0

# 可选：无人值守部署时，通过环境变量预先创建管理员
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password

# 使用 GitHub 镜像时取消注释，并替换为自己的仓库名
# IMAGE_NAME=ghcr.io/owner/sw-redeemed-coupons:latest
