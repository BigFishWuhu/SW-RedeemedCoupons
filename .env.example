# 首次启动时创建管理员。创建后修改此变量不会重置数据库中的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Web 端口与自动兑换时间
PORT=3000
APP_TIMEZONE=Asia/Shanghai
AUTO_REDEEM=true
AUTO_REDEEM_HOUR=12
AUTO_REDEEM_MINUTE=0

# 使用 GitHub 镜像时取消注释，并替换为自己的仓库名
# IMAGE_NAME=ghcr.io/owner/sw-redeemed-coupons:latest
